{
  "name": "@lastmile-gig/tests",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "test:load": "k6 run",
    "test:load:init": "k6 init"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/unit"],
    "testMatch": ["**/*.spec.ts"],
    "collectCoverageFrom": [
      "apps/**/*.ts",
      "!apps/**/*.d.ts"
    ],
    "coverageDirectory": "coverage/unit",
    "verbose": true,
    "setupFilesAfterEnv": ["<rootDir>/unit/setup.ts"]
  }
}