{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@lastmilegig/shared-types": ["libs/shared-types/src/index.ts"],
      "@lastmilegig/shared-ui": ["libs/shared-ui/src/index.ts"],
      "@lastmilegig/shared-utils": ["libs/shared-utils/src/index.ts"],
      "@lastmilegig/api-client": ["libs/api-client/src/index.ts"],
      "@lastmilegig/analytics": ["libs/analytics/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}